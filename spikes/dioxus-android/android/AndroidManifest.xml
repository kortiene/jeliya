<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Real-network Engine bootstrap. QUIC/UDP needs no permission beyond INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          Dioxus 0.7.9 supplies WryActivity and generated Kotlin/JNI glue. This
          custom subclass adds protected storage, SAF, resume observations, and
          a predictive-back callback. Rotation is intentionally handled through
          activity recreation (orientation is NOT listed in configChanges).
        -->
        <activity
            android:name="dev.dioxus.main.MainActivity"
            android:configChanges="keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="jeliya_spike_160" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
